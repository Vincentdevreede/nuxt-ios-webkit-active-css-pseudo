{
  "name": "@vincentdevreede/nuxt-ios-webkit-active-css-pseudo",
  "version": "1.0.3",
  "description": "A simple, lightweight Nuxt plugin that resolves the :active CSS pseudo-class issue in iOS WebKit browsers.",
  "repository": "https://github.com/Vincentdevreede/nuxt-ios-webkit-active-css-pseudo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24",
    "pnpm": "^10.7.1"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm lint && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.3.1",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@types/node": "^26.1.2",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.1",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808",
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.8"
    }
  }
}
